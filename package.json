{
  "name": "ciro-client",
  "version": "0.9.9",
  "private": true,
  "type": "module",
  "description": "Ciro conversational client",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node server/index.mjs",
    "dev:all": "concurrently -k \"npm:dev:server\" \"npm:dev\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:ci": "npm run test && npm run build && npm run test:e2e",
    "worker:plugins": "node server/plugin-worker.mjs",
    "verify:single-tenant": "node scripts/verify-ciro-single-tenant.mjs",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron .",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "pack:npm": "node scripts/pack-npm.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "electron-updater": "^6.8.9",
    "express": "^4.21.2",
    "fflate": "0.8.2",
    "html-to-image": "1.11.11",
    "jsqr": "1.4.0",
    "pyodide": "0.27.7",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@playwright/test": "^1.56.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "katex": "^0.16.47",
    "lucide-react": "^0.468.0",
    "opencc-js": "^1.4.2",
    "pdfjs-dist": "^4.10.38",
    "pngjs": "5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "typescript": "~5.7.3",
    "vite": "^6.0.6"
  },
  "main": "desktop/main.cjs",
  "author": {
    "name": "kllcoco"
  },
  "homepage": "https://github.com/kllcoco/frontend-UI",
  "build": {
    "appId": "com.kllcoco.ciro",
    "productName": "Ciro",
    "artifactName": "Ciro-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "desktop/**",
      "server/**",
      "dist/**",
      "build/icon.png",
      "package.json",
      "!server/**/*.test.*"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "Mac-Ciro-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Windows-Ciro-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Ciro"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "kllcoco",
      "synopsis": "Ciro AI desktop client",
      "artifactName": "Linux-Ciro-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kllcoco",
        "repo": "frontend-UI",
        "releaseType": "release"
      }
    ]
  }
}
