# Base of an OpenAI-compatible CIRO chat endpoint, e.g. http://127.0.0.1:8000/v1
# Leave blank to run the UI in explicitly labeled preview mode.
CIRO_API_BASE_URL=
CIRO_API_PATH=/chat/completions
CIRO_MODEL=ciro
# Optional comma-separated model IDs exposed by the backend.
CIRO_MODELS=
# Server-side only. Never put this in VITE_ variables or client code.
CIRO_API_KEY=
PORT=8787
HOST=127.0.0.1

# Workbench state directory (local, NOT inside a Git repository).
# Defaults to .ciro-runtime/ under the backend working directory.
CIRO_WORKSPACE_DATA_DIR=

# GitHub: grant narrowly scoped server-side access through a GitHub App or fine-grained token.
# Never paste the token into the browser UI; never commit it.
CIRO_GITHUB_TOKEN=
CIRO_GITHUB_REPOS=
# Explicit opt-in to writing commits to *nonprotected* branches under ciro/, feature/, repair/
CIRO_GITHUB_WRITES=false

# Optional native CIRO Agent orchestrator and independent verifier adapters.
# /workbench/step must accept the versioned POST contract documented in README.
# UI fails closed and does not claim actual agent execution unless configured.
CIRO_AGENT_RUNNER_URL=
CIRO_AGENT_RUNNER_TOKEN=
CIRO_VERIFIER_URL=
CIRO_VERIFIER_TOKEN=

# Only add browser app origins after separate authentication/CSRF controls are implemented.
CIRO_ALLOWED_ORIGINS=

# Signed CIRO runtime metering receipts: never expose keys to browser
CIRO_BILLING_EVENT_SECRET=
CIRO_BILLING_CWU_USD_PER_MILLION=
CIRO_BILLING_GWU_USD_PER_MILLION=
# These optional adapters only indicate configuration, not live verification
CIRO_RESEARCH_SERVICE_URL=
CIRO_RESEARCH_SERVICE_TOKEN=
CIRO_FILES_SERVICE_URL=
CIRO_FILES_SERVICE_TOKEN=

# Accounts. The first account (created with CIRO_BOOTSTRAP_TOKEN) is the server owner. Never put secrets in this repository.
CIRO_ACCOUNTS_ENABLED=false
# Who else may create accounts: closed (only the owner), invite (codes from Settings -> Users) or open.
CIRO_REGISTRATION=closed
# Optional cap on the number of accounts.
CIRO_MAX_USERS=
# development | single-owner | multi-user (hosted server for many people; needs HTTPS CIRO_PUBLIC_ORIGIN)
CIRO_DEPLOYMENT_MODE=
CIRO_BOOTSTRAP_TOKEN=
CIRO_API_KEY_PEPPER=
# Stable random 32-byte AES-256-GCM encryption key (standard Base64):
CIRO_ACCOUNT_DATA_KEY=
# External HTTPS origin (e.g. https://ciro.example.com)
CIRO_PUBLIC_ORIGIN=
# Real Stripe billing; disabled until credentials and HTTPS origin configured
CIRO_STRIPE_SECRET_KEY=
CIRO_STRIPE_PRICE_ID=
CIRO_STRIPE_WEBHOOK_SECRET=

# CIRO Studio V1 - native adapters. Every secret stays server-side.
# Explicitly set "deep" ONLY if the native chat completions adapter supports ciro_reasoning.
CIRO_CHAT_REASONING_MODES=
# Forward the composer thinking-depth slider as OpenAI-compatible reasoning_effort (on/off).
CIRO_REASONING_EFFORT=on
# Show the composer web-search toggle and forward it upstream as ciro_web_search=true (on/off).
CIRO_WEB_SEARCH=off
# v0.9.2 voice mode (speech-to-text + text-to-speech), image generation and team service
CIRO_VOICE=off
CIRO_STT_MODEL=whisper-1
CIRO_TTS_MODEL=tts-1
CIRO_TTS_VOICE=alloy
CIRO_IMAGES=off
CIRO_IMAGE_MODEL=gpt-image-1
CIRO_TEAM_URL=
CIRO_TEAM_TOKEN=
# Durable thinking: POST /v1/reasoning/jobs, GET /v1/reasoning/jobs/:id
CIRO_REASONING_URL=
CIRO_REASONING_TOKEN=
# Sandboxed IDE jobs: /v1/ide/jobs and job status
CIRO_IDE_RUNNER_URL=
CIRO_IDE_RUNNER_TOKEN=
# Presigned image/audio/video upload jobs
CIRO_MEDIA_SERVICE_URL=
CIRO_MEDIA_SERVICE_TOKEN=
# Comma-separated trusted HTTPS presigned upload origins
CIRO_MEDIA_UPLOAD_ORIGINS=
# Future semantic embedding / OCR adapter
CIRO_KNOWLEDGE_INDEX_URL=
CIRO_KNOWLEDGE_INDEX_TOKEN=
# Signed external application/skill manifest registry
CIRO_MARKETPLACE_URL=
CIRO_MARKETPLACE_TOKEN=
CIRO_MARKETPLACE_PUBLIC_KEY=

# Native CIRO training/model metadata, checkpoints and loss; read-only
CIRO_MODEL_CONTROL_URL=
CIRO_MODEL_CONTROL_TOKEN=

# V0.8 experimental plugin gateway. All secrets are server-side only.
# Requires CIRO_ACCOUNTS_ENABLED=true, HTTPS CIRO_PUBLIC_ORIGIN,
# and the existing stable CIRO_ACCOUNT_DATA_KEY to encrypt credentials.
# GitHub OAuth App callback: https://YOUR_DOMAIN/api/plugins/github/callback
CIRO_GITHUB_OAUTH_CLIENT_ID=
CIRO_GITHUB_OAUTH_CLIENT_SECRET=
# Hosted developer MCP endpoint is reserved for a future secure OAuth/session adapter.
# Do NOT put a Supabase service_role key in this field or in the browser.
CIRO_SUPABASE_MCP_URL=
