# Base of an OpenAI-compatible CIRO chat endpoint, e.g. http://127.0.0.1:8000/v1
# Leave blank to run the UI in explicitly labeled preview mode.
CIRO_API_BASE_URL=
CIRO_API_PATH=/chat/completions
CIRO_MODEL=ciro
# Optional comma-separated model IDs exposed by the backend.
CIRO_MODELS=
# Server-side only. Never put this in VITE_ variables or client code.
CIRO_API_KEY=
PORT=8787
HOST=127.0.0.1

# Workbench state directory (local, NOT inside a Git repository).
# Defaults to .ciro-runtime/ under the backend working directory.
CIRO_WORKSPACE_DATA_DIR=

# GitHub: grant narrowly scoped server-side access through a GitHub App or fine-grained token.
# Never paste the token into the browser UI; never commit it.
CIRO_GITHUB_TOKEN=
CIRO_GITHUB_REPOS=
# Explicit opt-in to writing commits to *nonprotected* branches under ciro/, feature/, repair/
CIRO_GITHUB_WRITES=false

# Optional native CIRO Agent orchestrator and independent verifier adapters.
# /workbench/step must accept the versioned POST contract documented in README.
# UI fails closed and does not claim actual agent execution unless configured.
CIRO_AGENT_RUNNER_URL=
CIRO_AGENT_RUNNER_TOKEN=
CIRO_VERIFIER_URL=
CIRO_VERIFIER_TOKEN=

# Only add browser app origins after separate authentication/CSRF controls are implemented.
CIRO_ALLOWED_ORIGINS=
